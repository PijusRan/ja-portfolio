---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { site } from '../data/site';

const hero = await getEntry('hero', 'index');
if (!hero) throw new Error('Missing src/content/hero/index.md');
const { images, rotate, interval } = hero.data;

// Pair the ordered picks: right slot = #1, #3, #5…; left slot = #2, #4, #6…
// With an odd count, the last pair's left image wraps back around to #2.
const pairs = [];
for (let i = 0; i < images.length; i += 2) {
  pairs.push({ right: images[i], left: images[i + 1] ?? images[1] ?? images[0] });
}

// Rotation only kicks in with more than one pair; otherwise this renders like a static hero.
const shouldRotate = rotate && pairs.length > 1;
const activePairs = shouldRotate ? pairs : pairs.slice(0, 1);

const rightSizes = '(max-width: 639px) 290px, (max-width: 1023px) 476px, 604px';
const leftSizes = '(max-width: 639px) 192px, (max-width: 1023px) 247px, 328px';
---

<section class="hero" aria-label="Pradžia" data-rotate={shouldRotate} data-interval={interval}>
  <div class="hero__right">
    {
      activePairs.map((pair, i) => (
        <Image
          src={pair.right.image}
          width={1265}
          sizes={rightSizes}
          alt={pair.right.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          class:list={['hero-frame', { 'is-active': i === 0 }]}
          style={`object-position: ${pair.right.focal}`}
        />
      ))
    }
  </div>
  <div class="hero__left">
    {
      activePairs.map((pair, i) => (
        <Image
          src={pair.left.image}
          width={690}
          sizes={leftSizes}
          alt={pair.left.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          class:list={['hero-frame', { 'is-active': i === 0 }]}
          style={`object-position: ${pair.left.focal}`}
        />
      ))
    }
  </div>
  <h1 class="h1">{site.name}</h1>
  {
    shouldRotate && (
      <button type="button" class="hero__toggle" data-hero-toggle aria-pressed="false" hidden>
        Sustabdyti
      </button>
    )
  }
</section>

<script>
  // Experimental: crossfades both hero slots through the extra picked images, in pairs.
  // A no-op unless a hero has data-rotate="true" and more than one pair of frames.
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    document.querySelectorAll('.hero[data-rotate="true"]').forEach((hero) => {
      const right = hero.querySelector('.hero__right');
      const left = hero.querySelector('.hero__left');
      if (!right || !left) return;

      const rightFrames = Array.from(right.querySelectorAll('.hero-frame'));
      const leftFrames = Array.from(left.querySelectorAll('.hero-frame'));
      const count = Math.min(rightFrames.length, leftFrames.length);
      if (count < 2) return;

      const intervalMs = (Number(hero.getAttribute('data-interval')) || 6) * 1000;
      const toggle = hero.querySelector<HTMLButtonElement>('[data-hero-toggle]');
      let index = 0;
      let timer: number | null = null;
      // Paused with the button: stays paused until the button is pressed again
      let paused = false;

      function show(next: number) {
        rightFrames[index].classList.remove('is-active');
        leftFrames[index].classList.remove('is-active');
        rightFrames[next].classList.add('is-active');
        leftFrames[next].classList.add('is-active');
        index = next;
      }

      function start() {
        if (timer !== null || paused) return;
        timer = window.setInterval(() => show((index + 1) % count), intervalMs);
      }

      function stop() {
        if (timer === null) return;
        window.clearInterval(timer);
        timer = null;
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      // WCAG 2.2.2: moving content needs a way to pause it. The button only shows once JS runs.
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          paused = !paused;
          toggle.setAttribute('aria-pressed', String(paused));
          toggle.textContent = paused ? 'Paleisti' : 'Sustabdyti';
          if (paused) stop();
          else start();
        });
      }

      start();
    });
  })();
</script>

<style>
  .hero {
    /* Single knob for the overall hero size; everything below scales off this. */
    --hero-scale: 1.15;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: calc(300px * var(--hero-scale)) 0;
  }

  .hero h1 {
    position: relative;
    color: #fff;
    mix-blend-mode: difference;
    white-space: nowrap;
    z-index: 1;
  }

  .hero__toggle {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 5px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.75em;
    letter-spacing: 0.04em;
    text-transform: inherit;
    cursor: pointer;
  }

  .hero__toggle:hover {
    opacity: 0.6;
  }

  .hero__right,
  .hero__left {
    position: absolute;
    overflow: hidden;
  }

  .hero__right :global(.hero-frame),
  .hero__left :global(.hero-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__right :global(.hero-frame.is-active),
  .hero__left :global(.hero-frame.is-active) {
    opacity: 1;
  }

  /* Landing: each slot wipes open (right from the top, left from the bottom) while its
     photo settles from a slight zoom; the name then rises in (global.css, "Motion") */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wipe-down {
      from {
        clip-path: inset(0 0 100% 0);
      }
    }

    @keyframes wipe-up {
      from {
        clip-path: inset(100% 0 0 0);
      }
    }

    @keyframes settle {
      from {
        transform: scale(1.12);
      }
    }

    .hero__right {
      animation: wipe-down 1.4s var(--ease-wipe) 0.15s both;
    }

    .hero__left {
      animation: wipe-up 1.4s var(--ease-wipe) 0.35s both;
    }

    .hero__right :global(.hero-frame) {
      animation: settle 2.2s var(--ease-out) 0.15s both;
    }

    .hero__left :global(.hero-frame) {
      animation: settle 2.2s var(--ease-out) 0.35s both;
    }

    /* The name waits until the photos are mostly open */
    .hero h1 {
      animation-delay: 0.9s;
    }

    .hero__toggle {
      animation: fade-in 1s var(--ease-out) 1.6s both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__right :global(.hero-frame),
    .hero__left :global(.hero-frame) {
      transition: none;
    }
  }

  .hero__right {
    top: calc(14px * var(--hero-scale));
    right: 0;
    width: calc(524.6px * var(--hero-scale));
    height: calc(498px * var(--hero-scale));
  }

  .hero__left {
    bottom: 0;
    left: 0;
    width: calc(285px * var(--hero-scale));
    height: calc(369px * var(--hero-scale));
  }

  @media (max-width: 1023px) {
    .hero__right {
      top: 0;
      width: calc(414px * var(--hero-scale));
      height: calc(393px * var(--hero-scale));
    }

    .hero__left {
      width: calc(215.5px * var(--hero-scale));
      height: calc(279px * var(--hero-scale));
    }
  }

  @media (max-width: 639px) {
    .hero__right {
      width: calc(251.8px * var(--hero-scale));
      height: calc(239px * var(--hero-scale));
    }

    .hero__left {
      width: calc(166.8px * var(--hero-scale));
      height: calc(216px * var(--hero-scale));
    }
  }
</style>
