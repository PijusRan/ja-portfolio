---
import { Image } from 'astro:assets';
import { galleryUrl, getGalleryPhotos, imageSize, type Gallery } from '../lib/photos';

interface Props {
  gallery: Gallery;
  index: number;
}

// The cover plus the album's next few photos crossfade in the row (see the script below)
const MAX_FRAMES = 5;

const { gallery, index } = Astro.props;
const { brand, season, title, layout, focal } = gallery.data;
const href = galleryUrl(gallery);
const frames = getGalleryPhotos(gallery).slice(0, MAX_FRAMES);
const number = String(index + 1).padStart(2, '0');
// On phones the image box takes the cover's own proportions (so horizontal photos stay
// horizontal), kept between 3:4 and 7:4 so very tall or very wide covers don't look odd
const cover = imageSize(frames[0]);
const ratio = Math.min(1.75, Math.max(0.75, cover.width / cover.height)).toFixed(4);
const isFull = layout === 'full';
const width = isFull ? 2400 : 1200;
const sizes = isFull
  ? '(min-width: 1024px) 1240px, 100vw'
  : '(min-width: 1024px) 595px, (min-width: 640px) 355px, 335px';
---

<section
  class:list={['project', `project--${layout}`]}
  data-reveal
  data-rotate={frames.length > 1 ? '' : undefined}
  aria-label={`Projektas ${number}: ${title}`}
>
  {
    !isFull && (
      <div class="project__text h2">
        <p>{number}</p>
        <p class="project__title">
          <a href={href}>
            {brand ?? title}
            {season && <br />}
            {season}
          </a>
        </p>
      </div>
    )
  }
  {/* The title is the keyboard / screen reader link; this one is just a bigger target for the mouse */}
  <a class="project__image" href={href} tabindex="-1" aria-hidden="true" style={`--cover-ratio: ${ratio}`}>
    {
      frames.map((photo, i) => (
        <Image
          src={photo}
          {width}
          {sizes}
          alt={i === 0 ? title : ''}
          loading={i === 0 && index < 2 ? 'eager' : 'lazy'}
          class:list={['project__frame', { 'is-active': i === 0 }]}
          style={`object-position: ${i === 0 ? focal : '50% 50%'}`}
        />
      ))
    }
  </a>
  {
    isFull && (
      <div class="project__caption h2">
        <p>{number}</p>
        <p>
          <a href={href}>{brand ?? title}</a>
        </p>
        <p>{season}</p>
      </div>
    )
  }
</section>

<script>
  // Each row with more than one frame crossfades through them on its own timer. It only runs while
  // the row is on screen and the tab is visible, and holds still while the row is hovered or has
  // focus, so a visitor can look at (and click through to) the photo that caught their eye.
  const INTERVAL = 4000;

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.project[data-rotate]')).map((row) => ({
      row,
      frames: Array.from(row.querySelectorAll<HTMLElement>('.project__frame')),
      index: 0,
      timer: null as number | null,
      visible: false,
      held: false,
    }));
    type Row = (typeof rows)[number];

    const update = (r: Row) => {
      const run = r.visible && !r.held && !document.hidden;
      if (run && r.timer === null) {
        r.timer = window.setInterval(() => {
          r.frames[r.index].classList.remove('is-active');
          r.index = (r.index + 1) % r.frames.length;
          r.frames[r.index].classList.add('is-active');
        }, INTERVAL);
      } else if (!run && r.timer !== null) {
        window.clearInterval(r.timer);
        r.timer = null;
      }
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const r = rows.find((r) => r.row === entry.target);
        if (!r) continue;
        r.visible = entry.isIntersecting;
        update(r);
      }
    });

    for (const r of rows) {
      const hold = (held: boolean) => () => {
        r.held = held;
        update(r);
      };
      r.row.addEventListener('pointerenter', hold(true));
      r.row.addEventListener('pointerleave', hold(false));
      r.row.addEventListener('focusin', hold(true));
      r.row.addEventListener('focusout', hold(false));
      observer.observe(r.row);
    }

    document.addEventListener('visibilitychange', () => rows.forEach(update));
  }
</script>

<style>
  .project {
    display: flex;
    gap: 50px;
    padding-bottom: 90px;
  }

  .project__image {
    position: relative;
    display: block;
    overflow: hidden;
    height: 543px;
    flex: 1 0 0;
    min-width: 1px;
  }

  /* Frames are stacked; the active one fades in over the others (same as the hero) */
  .project__image :global(.project__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .project__image :global(.project__frame.is-active) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project__image :global(.project__frame) {
      transition: none;
    }
  }

  .project__text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 0 0;
    min-width: 1px;
    height: 543px;
  }

  .project__title {
    line-height: 0.8;
  }

  /* Image on the left: swap the columns */
  .project--image-left {
    flex-direction: row-reverse;
  }

  .project--narrow-left,
  .project--narrow-right {
    align-items: center;
  }

  .project--narrow-left {
    flex-direction: row-reverse;
  }

  .project--narrow-left .project__image {
    flex: 0 0 375px;
  }

  .project--narrow-right .project__image {
    flex: 0 0 414px;
  }

  /* Full width image with number / brand / season underneath */
  .project--full {
    flex-direction: column;
  }

  .project--full .project__image {
    flex: none;
    width: 100%;
  }

  .project__caption {
    display: flex;
    justify-content: space-between;
    padding-bottom: 90px;
    white-space: nowrap;
  }

  .project__caption p:nth-child(2) {
    text-align: center;
  }

  .project__caption p:last-child {
    text-align: right;
  }

  @media (max-width: 1023px) {
    .project--narrow-left .project__image,
    .project--narrow-right .project__image {
      flex-basis: 355px;
    }
  }

  /* Mobile: image first, then number and title stacked under it */
  @media (max-width: 639px) {
    .project,
    .project--image-left,
    .project--narrow-left,
    .project--narrow-right {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .project--full {
      flex-direction: column;
    }

    .project__image,
    .project--narrow-left .project__image,
    .project--narrow-right .project__image {
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: var(--cover-ratio);
    }

    .project__text {
      flex: none;
      height: auto;
      justify-content: flex-start;
    }
  }
</style>
