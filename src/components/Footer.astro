---
import { site } from '../data/site';
---

<footer class="footer">
  <div class="footer__top">
    <p>{site.cities.left}</p>
    <p class="footer__name">{site.name}</p>
    <p>{site.cities.right}</p>
  </div>
  <div class="footer__middle">
    <div class="footer__socials">
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">Insta</a>
      <a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
    <p>Made by</p>
  </div>
  <div class="footer__initials" aria-hidden="true">
    <span>J</span>
    <span class="footer__dot">.</span>
    <span class="footer__a">A</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 30px 40px;
    background: var(--footer-bg);
    color: var(--footer-fg);
    overflow: hidden;
    /* The wordmark below is sized from this box's inner width (cqw), padding already taken off */
    container-type: inline-size;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    padding-bottom: 100px;
    white-space: nowrap;
  }

  .footer__middle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 120px;
  }

  /* Equal columns so the links sit symmetrically whatever the label widths */
  .footer__socials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    justify-items: center;
    width: 100%;
    max-width: 800px;
  }

  /* Big wordmark: J at the left edge, A at the right, the dot centred between them.
     605px across the 1160px-wide footer in the 1280 design, i.e. 52% of the footer's inner
     width at every screen size. At that size the A (about 0.76em wide, the widest letter)
     still fits its half with room to spare, so nothing gets clipped. */
  .footer__initials {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    font-size: min(52cqw, 605px);
    line-height: 0.75;
    letter-spacing: -0.02em;
    overflow: hidden;
    user-select: none;
  }

  /* The J's hook and the A's right foot reach slightly past their letter boxes, which the
     overflow: hidden above would cut off */
  .footer__initials > :first-child {
    padding-left: 0.03em;
  }

  .footer__a {
    justify-self: end;
    padding-right: 0.04em;
  }

  @media (max-width: 1023px) {
    .footer__socials {
      max-width: 520px;
    }
  }

  /* Mobile frame (375px): city + city only, socials spread out, narrower side padding so
     the wordmark can stay big */
  @media (max-width: 639px) {
    .footer {
      padding: 30px 20px;
    }

    .footer__name {
      display: none;
    }

    .footer__socials {
      max-width: none;
    }

    .footer__socials > :first-child {
      justify-self: start;
    }

    .footer__socials > :last-child {
      justify-self: end;
    }
  }
</style>
