---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { withBase } from '../lib/url';

const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order).slice(0, 21);
---

<div class="work-grid">
  {
    galleries.map((gallery, i) => (
      <a href={withBase(`/gallery/${gallery.id}/`)} class="work-grid__tile">
        <Image
          src={gallery.data.coverImage}
          width={320}
          height={320}
          format="webp"
          alt={`${gallery.data.title}, projektas ${i + 1} iš ${galleries.length}`}
          loading="lazy"
          style={`object-position: ${gallery.data.focal}`}
        />
      </a>
    ))
  }
</div>

<style>
  .work-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 8px;
    padding-bottom: 10px;
  }

  .work-grid__tile {
    display: block;
    flex-shrink: 0;
    width: 158.857px;
    height: 158.857px;
    min-width: 140px;
    min-height: 140px;
  }

  .work-grid__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
