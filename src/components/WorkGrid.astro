---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getPreviewPhotos } from '../lib/preview';
import { withBase } from '../lib/url';

// Three rows of seven tiles in the desktop design; the rest are on /darbai
const MAX_TILES = 21;

const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order).slice(0, MAX_TILES);
const previews = await Promise.all(galleries.map(getPreviewPhotos));
---

<div class="work-grid">
  {
    galleries.map((gallery, i) => (
      <button type="button" class="work-grid__tile" data-preview={JSON.stringify(previews[i])} aria-haspopup="dialog">
        <Image
          src={gallery.data.coverImage}
          width={320}
          height={320}
          format="webp"
          alt={`${gallery.data.title}, projektas ${i + 1} iš ${galleries.length}`}
          loading="lazy"
          style={`object-position: ${gallery.data.focal}`}
        />
      </button>
    ))
  }
</div>
<a class="work-grid__all" href={withBase('/darbai/')}>Visi darbai →</a>

<style>
  .work-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 8px;
    padding-bottom: 10px;
  }

  .work-grid__tile {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    flex-shrink: 0;
    width: 158.857px;
    height: 158.857px;
  }

  .work-grid__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-grid__all {
    align-self: center;
    padding: 3px 5px;
  }
</style>
