---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/global.css';
import displayFont from '../assets/fonts/montserrat-latin-600-normal.woff2?url';
import { withBase } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** cream (home, default), light (work), dark (about) */
  theme?: 'cream' | 'light' | 'dark';
  /** keep the page out of search results */
  noindex?: boolean;
  /** link preview image (Open Graph); defaults to the first hero image */
  image?: ImageMetadata;
}

const {
  title,
  description = 'Justas Andžius – fotografas. Pasvalys, Vilnius.',
  theme = 'cream',
  noindex = false,
  image,
} = Astro.props;

// Canonical and Open Graph URLs must be absolute, so they need `site` (set on Netlify and GitHub Pages)
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const shareImage = image ?? (await getEntry('hero', 'index'))?.data.images[0]?.image;
const ogImage =
  Astro.site && shareImage && (await getImage({ src: shareImage, width: 1200, format: 'jpg' }));
---

<html lang="lt">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:site_name" content="Justas Andžius" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />
          <meta property="og:image:width" content={String(ogImage.attributes.width)} />
          <meta property="og:image:height" content={String(ogImage.attributes.height)} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <!-- Scroll reveals only hide content once we know the script below will show it again -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#turinys">Pereiti prie turinio</a>
    <div class="page">
      <header>
        <Header />
      </header>
      <slot />
      <Footer />
    </div>
    <script>
      // Fade [data-reveal] elements in as they scroll into view (styles in global.css, "Motion")
      const targets = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
