---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Preview from '../components/Preview.astro';
import arrow from '../assets/site/arrow-down.svg';
---

<Layout title="Justas Andžius">
  <div class="home">
    <Hero />
    <main id="darbai">
      <div class="discover">
        <h2 class="h2">Darbai darbeliai</h2>
        <img class="discover__arrow" src={arrow.src} width="6" height="5" alt="" />
      </div>
      <WorkGrid />
    </main>
  </div>
  <Preview />
</Layout>

<style>
  /* Sections are separated by 50px in the home design */
  .home {
    display: flex;
    flex-direction: column;
    gap: 50px;
    padding: 50px 0;
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .discover {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 100px 0;
    border-top: 0.5px solid var(--divider);
    text-align: center;
  }

  /* The exported triangle points up; the design flips it to point down */
  .discover__arrow {
    transform: scaleY(-1);
  }
</style>
