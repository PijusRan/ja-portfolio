---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { galleryUrl, getGalleries } from '../lib/photos';

const galleries = await getGalleries();

const cards = galleries.map((gallery, i) => ({
  gallery,
  href: galleryUrl(gallery),
  number: String(i + 1).padStart(2, '0'),
  name: gallery.data.brand ?? gallery.data.title,
}));
---

<Layout title={`Darbai — ${site.name}`} description={`${site.name} – fotografijos darbai.`} theme="light">
  <main id="turinys" class="work">
    <header class="work__header">
      <h1 class="h1">Darbai</h1>
    </header>

    <ol class="work__grid" role="list">
      {
        cards.map(({ gallery, href, number, name }, i) => {
          const featured = i === 0;
          return (
            <li class:list={['card', { 'card--featured': featured }]} data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
              <a class="card__link" href={href}>
                <div class="card__media">
                  <Image
                    src={gallery.data.coverImage}
                    width={featured ? 2400 : 1200}
                    widths={featured ? [800, 1200, 1600, 2400] : [400, 800, 1200]}
                    sizes={
                      featured
                        ? '(min-width: 640px) calc(100vw - 40px), 100vw'
                        : '(min-width: 1024px) calc((100vw - 72px) / 3), (min-width: 640px) calc((100vw - 56px) / 2), calc(100vw - 40px)'
                    }
                    alt=""
                    loading={i < 4 ? 'eager' : 'lazy'}
                    fetchpriority={featured ? 'high' : undefined}
                    style={`object-position: ${gallery.data.focal}`}
                  />
                </div>
                <div class="card__body">
                  <span class="card__number" aria-hidden="true">{number}</span>
                  <div class="card__text">
                    <h2 class="card__title">{name}</h2>
                    {gallery.data.season && <p class="card__meta">{gallery.data.season}</p>}
                  </div>
                  <span class="card__arrow" aria-hidden="true">→</span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ol>

    <section class="work__cta" aria-labelledby="cta-title" data-reveal>
      <h2 id="cta-title" class="work__cta-title">Norite tokių nuotraukų?</h2>
      {/* Opens the contact dialog (Contact.astro); a plain mailto: link without JavaScript */}
      <a class="work__cta-button h2" href={`mailto:${site.email}`} data-contact-open aria-haspopup="dialog">
        Susisiekite
      </a>
    </section>
  </main>
</Layout>

<style>
  .work {
    --gap: 16px;
    --gap-row: 48px;
    --meta: #636363; /* 5.9:1 on white, unlike --muted (2.8:1) */
  }

  /* Short title so the first photos show above the fold */
  .work__header {
    padding: 72px 0 40px;
    border-bottom: 1px solid #d9d9d9;
    margin-bottom: 32px;
  }

  /* One column on phones, two on tablets, three on desktop. The first album spans the row. */
  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-row) var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card--featured {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* The whole card is one link: one tab stop, one big target */
  .card__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  /* Cards keep their look on hover instead of the site-wide link fade */
  .card__link:hover,
  .card__link:focus-visible {
    opacity: 1;
  }

  .card__link:focus-visible {
    outline-offset: 6px;
  }

  /* Same shape for every cover so rows line up; the focal point set in the admin picks the crop */
  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #eee;
  }

  @media (min-width: 640px) {
    .card--featured .card__media {
      aspect-ratio: 21 / 9;
    }
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 16px;
  }

  .card__number,
  .card__meta {
    color: var(--meta);
    font-size: 0.75em;
    letter-spacing: 0.04em;
  }

  .card__number {
    min-width: 2ch;
    font-variant-numeric: tabular-nums;
    line-height: 1.33;
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .card__title {
    overflow-wrap: anywhere; /* a long name without spaces can't push past a narrow phone screen */
    font-size: var(--text-base);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  /* On phones the first album looks like the rest; from tablets up it gets the wide photo and big title */
  @media (min-width: 640px) {
    .card--featured .card__title {
      font-size: var(--text-h1);
      line-height: 1;
    }
  }

  .card__meta {
    line-height: 1.3;
  }

  .card__arrow {
    line-height: 1.1;
  }

  /* Hover effects only where there's a real pointer, so they don't stick after a tap on phones */
  @media (hover: hover) {
    .card__link:hover .card__title {
      text-decoration-color: currentColor;
    }
  }

  .card__link:focus-visible .card__title {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card__media :global(img) {
      transition: transform 0.8s var(--ease-out);
    }

    .card__arrow {
      transition: transform 0.4s var(--ease-out);
    }

    .card__title {
      transition: text-decoration-color 0.25s var(--ease-out);
    }

    .card__link:focus-visible .card__media :global(img) {
      transform: scale(1.03);
    }

    .card__link:focus-visible .card__arrow {
      transform: translateX(4px);
    }

    @media (hover: hover) {
      .card__link:hover .card__media :global(img) {
        transform: scale(1.03);
      }

      .card__link:hover .card__arrow {
        transform: translateX(4px);
      }
    }
  }

  /* Next step after the last album */
  .work__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    margin-top: 120px;
    padding: 120px 20px;
    border-top: 1px solid #d9d9d9;
    text-align: center;
  }

  .work__cta-title {
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .work__cta-button {
    padding: 22px 48px;
    border: 1px solid currentColor;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }

  .work__cta-button:hover,
  .work__cta-button:focus-visible {
    opacity: 1;
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 639px) {
    .work {
      --gap-row: 40px;
    }

    .work__header {
      padding-top: 40px;
    }

    .work__cta {
      margin-top: 80px;
      padding: 80px 0;
    }
  }
</style>
