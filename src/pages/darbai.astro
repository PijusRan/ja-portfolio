---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Preview from '../components/Preview.astro';
import { site } from '../data/site';

const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`Darbai — ${site.name}`} description={`${site.name} – fotografijos darbai.`} theme="light">
  <h1 class="page-title h1">{site.name}</h1>
  <main id="turinys">
    {galleries.map((gallery, i) => <ProjectRow gallery={gallery} index={i} />)}
  </main>
  <Preview />
</Layout>
