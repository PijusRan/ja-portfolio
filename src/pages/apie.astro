---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const about = await getEntry('about', 'index');
if (!about) throw new Error('Missing src/content/about/index.md');
const { image, focal, alt } = about.data;
const { Content } = await render(about);
---

<Layout title={`Apie mane — ${site.name}`} description={`Apie fotografą ${site.name}.`} theme="dark" image={image}>
  <h1 class="page-title h1">{site.name}</h1>
  <main id="turinys">
    <div class="about">
      <div class="about__image">
        <Image
          src={image}
          width={1000}
          sizes="(min-width: 1024px) 461px, (min-width: 640px) 560px, 335px"
          alt={alt}
          loading="eager"
          style={`object-position: ${focal}`}
        />
      </div>
      <div class="about__bio"><Content /></div>
    </div>
    <div class="cta">
      <h2 class="h2">
        Papildoma informacija:{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </h2>
    </div>
  </main>
</Layout>

<style>
  .about {
    display: flex;
    align-items: flex-start;
    gap: 118px;
    padding: 0 100px 150px;
  }

  .about__image,
  .about__bio {
    flex: 1 0 0;
    min-width: 1px;
  }

  .about__image {
    aspect-ratio: 1;
  }

  .about__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__bio {
    padding-right: 100px;
    font-family: var(--font-body);
    font-size: var(--text-bio);
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  /* The bio is rendered markdown (edited in the admin) */
  .about__bio :global(p) {
    margin: 0 0 1em;
  }

  .about__bio :global(p:last-child) {
    margin-bottom: 0;
  }

  .about__bio :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  .cta {
    display: flex;
    justify-content: center;
    padding: 300px 80px;
    border-top: 1px solid var(--divider);
    text-align: center;
  }

  /* Wraps onto several lines on narrow screens; .h2's 0.8 line-height is too tight for that */
  .cta .h2 {
    line-height: 1.25;
  }

  @media (max-width: 1023px) {
    .about {
      flex-direction: column;
      gap: 118px;
    }

    .about__image {
      flex: none;
      width: 100%;
      aspect-ratio: 560 / 500;
    }

    .about__bio {
      flex: none;
      padding-right: 0;
    }
  }

  @media (max-width: 639px) {
    .about {
      padding: 0 0 150px;
    }

    .about__image {
      aspect-ratio: 335 / 400;
    }

    .cta {
      padding: 300px 40px;
    }
  }
</style>
