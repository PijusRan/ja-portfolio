---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.tsx';

export async function getStaticPaths() {
  const galleries = await getCollection('galleries');
  return galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const { Content } = await render(gallery);

const THUMB_WIDTHS = [320, 480, 768];
const FULL_WIDTHS = [768, 1200, 1600, 2400];

async function buildSrcSet(src: ImageMetadata, widths: number[]) {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const photos = await Promise.all(
  gallery.data.photos.map(async (photo, i) => {
    const [thumb, thumbSrcset, full, fullSrcset] = await Promise.all([
      getImage({ src: photo, width: 480, format: 'webp' }),
      buildSrcSet(photo, THUMB_WIDTHS),
      getImage({ src: photo, width: 1600, format: 'webp' }),
      buildSrcSet(photo, FULL_WIDTHS),
    ]);
    return {
      alt: `${gallery.data.title}, ${i + 1}`,
      thumb: { src: thumb.src, srcset: thumbSrcset },
      full: { src: full.src, srcset: fullSrcset },
    };
  })
);
---

<Layout title={`${gallery.data.title} — Justas Andžius`} description={gallery.data.description} theme="light">
  <main class="gallery-detail">
    <h1 class="h1">{gallery.data.title}</h1>
    {gallery.data.description && <p>{gallery.data.description}</p>}
    <div class="gallery-detail__body"><Content /></div>
    <Lightbox client:load photos={photos} />
  </main>
</Layout>
